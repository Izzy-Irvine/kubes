# tuhaha-ci: the runner and job image for the Codeberg Forgejo Actions runner.
# Jobs run with the runner's host executor, so this image provides the Forgejo
# runner itself plus Nix, OpenTofu, OpenSSH, git and Node.
#
#   docker buildx build --push \
#     -t ghcr.io/izzy-irvine/tuhaha-ci:latest \
#     Dockerfiles/tuhaha-ci
FROM data.forgejo.org/forgejo/runner:13 AS runner

FROM nixos/nix:2.31.2

USER root

# The base image already sets sandbox = false. Enable flakes for future jobs.
RUN printf '%s\n' 'experimental-features = nix-command flakes' >> /etc/nix/nix.conf

# Use the base image's pinned nixpkgs channel, so this is reproducible per tag.
RUN nix-env -iA \
      nixpkgs.bash \
      nixpkgs.coreutils \
      nixpkgs.curl \
      nixpkgs.gitMinimal \
      nixpkgs.jq \
      nixpkgs.nodejs_24 \
      nixpkgs.openssh \
      nixpkgs.opentofu \
      nixpkgs.zstd \
      nixpkgs.gnutar \
      nixpkgs.gzip \
    && nix store gc

# The host executor runs jobs in this container, so the daemon ships here too.
COPY --from=runner /bin/forgejo-runner /usr/local/bin/forgejo-runner

ENV PATH="/usr/local/bin:${PATH}"

# Fail the build early if a tool is missing.
RUN nix --version \
    && tofu version \
    && forgejo-runner --version \
    && node --version \
    && ssh -V \
    && jq --version \
    && zstd --version

WORKDIR /workspace
